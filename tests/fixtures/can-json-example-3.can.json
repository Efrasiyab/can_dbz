{
    "format": "can-db",
    "format_version": 1,
    "name": "MuxDemo",
    "buses": [
        {
            "name": "can0"
        }
    ],
    "messages": [
        {
            "name": "PagedData",
            "bus": "can0",
            "id": "0x300",
            "extended": false,
            "frame": "classic",
            "length": 8,
            "signals": [
                {
                    "name": "Page",
                    "start_bit": 0,
                    "bit_length": 8,
                    "byte_order": "little_endian",
                    "type": "unsigned",
                    "is_multiplexer": true
                },
                {
                    "name": "Temperature",
                    "start_bit": 8,
                    "bit_length": 16,
                    "byte_order": "little_endian",
                    "type": "signed",
                    "factor": "0.1",
                    "offset": "-40",
                    "unit": "C",
                    "when": [
                        {
                            "selector": "Page",
                            "ranges": [
                                [
                                    "1",
                                    "1"
                                ],
                                [
                                    "3",
                                    "3"
                                ]
                            ]
                        }
                    ]
                },
                {
                    "name": "Pressure",
                    "start_bit": 8,
                    "bit_length": 16,
                    "byte_order": "little_endian",
                    "type": "unsigned",
                    "factor": "0.5",
                    "offset": "0",
                    "unit": "kPa",
                    "when": [
                        {
                            "selector": "Page",
                            "ranges": [
                                [
                                    "2",
                                    "2"
                                ]
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}